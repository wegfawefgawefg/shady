{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 20, "patch": 0 },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Shady debug",
      "binaryDir": "${sourceDir}/build-shady",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SHADY_STRICT": true,
        "SHADY_WARN_AS_ERROR": true,
        "SHADY_BUILD_DESKTOP": true,
        "SHADY_BUILD_FRAME": true,
        "SHADY_BUILD_TESTS": true
      }
    },
    {
      "name": "release",
      "displayName": "Shady release",
      "binaryDir": "${sourceDir}/build-shady-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SHADY_STRICT": true,
        "SHADY_WARN_AS_ERROR": true,
        "SHADY_BUILD_DESKTOP": true,
        "SHADY_BUILD_FRAME": true,
        "SHADY_BUILD_TESTS": true
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev", "jobs": 0 },
    { "name": "release", "configurePreset": "release", "jobs": 0 }
  ]
}
